BOT_TOKEN=your_bot_token_here
MAX_CONCURRENT_DOWNLOADS=5
CHANNEL_URL=https://t.me/your_channel

# Telegram user_id администратора
ADMIN_ID=123456789

# Секунд между запросами от одного пользователя
RATE_LIMIT_SECONDS=10

# Максимум ссылок в одном сообщении
MAX_LINKS_PER_MESSAGE=3

# Через сколько дней удалять неиспользуемый кэш
CACHE_TTL_DAYS=30

# ==============================================================================
# THREADS AUTO-POSTER CONFIGURATION
# ==============================================================================
# Meta Threads User Access Token (from developers.facebook.com)
THREADS_ACCESS_TOKEN=your_threads_access_token_here
# Optional: Threads User ID (auto-detected via API if empty)
THREADS_USER_ID=

# Posting frequency (~50 posts per day = ~22-35 min interval)
THREADS_POSTS_PER_DAY=50
THREADS_INTERVAL_MINUTES_MIN=22
THREADS_INTERVAL_MINUTES_MAX=35

# Link to your bot for bio or automated first reply
THREADS_TELEGRAM_BOT_URL=https://t.me/SunoSaverBot
# Automatically post a reply under each post with the bot link (true / false)
THREADS_AUTO_FIRST_REPLY=false
THREADS_FIRST_REPLY_TEMPLATE=✨ Grab studio WAV stems & full lyrics with our free Telegram bot: {url}

# Queue recycling: reset all published posts back to pending when queue ends (true / false)
THREADS_RECYCLE_POSTS=false

