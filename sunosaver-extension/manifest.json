{
  "manifest_version": 3,
  "name": "SunoSaver — Suno AI Music & MP3 Downloader",
  "version": "1.1.0",
  "description": "Download Suno AI songs in high quality MP3/WAV, download full playlists, and split vocals & stems with one click.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "SunoSaver — Download Suno Music"
  },
  "permissions": [
    "downloads",
    "activeTab",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "*://*.suno.com/*",
    "*://*.suno.ai/*",
    "*://*.cloudfront.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.suno.com/*",
        "*://*.suno.ai/*"
      ],
      "js": ["lib/lame.min.js", "downloader.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
